# Sanity — leave unset to build from the checked-in content in src/data/.
# With these set, the site reads from the CMS and falls back to src/data/
# whenever a document type has nothing published yet.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Paystack (Phase 4). The secret key is used only by the serverless
# function — it must never be prefixed PUBLIC_ or referenced in a page.
PAYSTACK_SECRET_KEY=
PUBLIC_PAYSTACK_PUBLIC_KEY=

# The public domain. Used for the sitemap, robots.txt and canonical/OG tags.
SITE_URL=https://kingdomofgods.org

# Sanity — leave unset to build from the checked-in content in src/data/.
# With these set, the site reads from the CMS and falls back to src/data/
# whenever a document type has nothing published yet.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Paystack. Only the PUBLIC key belongs here — it decides whether the giving
# form is enabled and whether the page shows the test-mode banner.
#
# The SECRET key does NOT go in this file. It lives in paystack-config.php,
# placed ABOVE the web root on the server, where the browser cannot reach it.
# Start with pk_test_... and only move to pk_live_... after a test payment.
PUBLIC_PAYSTACK_PUBLIC_KEY=

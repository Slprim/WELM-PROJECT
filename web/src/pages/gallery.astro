---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import SanityImage from "../components/SanityImage.astro";
import { site } from "../data/site";
import { getPage, getGallery } from "../lib/content";

/**
 * The gallery.
 *
 * The legacy Gallery page linked six `img/portfolio-*.jpg` files that are not
 * in the repo at all, so it rendered six broken images. This one is driven
 * entirely from the CMS, and shows an honest empty state rather than
 * placeholder tiles when there is nothing to show.
 */
const page = await getPage("gallery", {
  eyebrow: "Gallery",
  title: "Moments from the house",
  lede: "Sundays, conferences and the ordinary weeks in between.",
  seoDescription: `Photographs from ${site.legalName} in ${site.address.city} — Sunday services, conferences and gatherings.`,
});

const photos = await getGallery();
---

<Base title="Gallery" description={page.seoDescription}>
  <PageHeader eyebrow={page.eyebrow} title={page.title} lede={page.lede} />

  <section class="section bg-sand-50">
    <div class="shell">
      {
        photos.length > 0 ? (
          /* A masonry column layout: photos keep their own proportions
             instead of being cropped into a uniform grid. */
          <div class="gap-5 [column-fill:_balance] sm:columns-2 lg:columns-3">
            {photos.map((photo, i) => (
              <figure
                class="mb-5 break-inside-avoid overflow-hidden rounded-2xl border border-sand-200 bg-white"
                data-reveal="scale"
                data-reveal-delay={
                  i % 3 === 1 ? "100" : i % 3 === 2 ? "180" : undefined
                }
              >
                <SanityImage
                  image={photo.image}
                  alt={photo.image?.alt ?? ""}
                  class="w-full"
                  sizes="(min-width: 1024px) 32vw, (min-width: 640px) 48vw, 100vw"
                  loading={i < 6 ? "eager" : "lazy"}
                />
                {photo.caption && (
                  <figcaption class="px-5 py-4 text-sm text-sand-600">
                    {photo.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        ) : (
          <p class="mx-auto max-w-xl rounded-3xl border border-sand-300 bg-sand-100 p-8 text-center leading-relaxed text-sand-600">
            <strong class="block text-navy-900">No photos yet.</strong>
            Add them in the Studio under <em>Gallery page → The photos</em> and
            they will appear here.
          </p>
        )
      }
    </div>
  </section>
</Base>

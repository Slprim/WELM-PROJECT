---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";
import SanityImage from "../components/SanityImage.astro";
import { getPosts } from "../lib/content";

const posts = await getPosts();

const [lead, ...rest] = posts;
---

<Base
  title="Blog"
  description={`Short teachings and reflections from ${site.legalName} — on grace, identity in Christ, and eternal life.`}
>
  <PageHeader
    eyebrow="Blog"
    title="Short words, worth sitting with"
    lede="Reflections from the house — on grace, identity, and the life God has already given."
  />

  <section class="section bg-sand-50">
    <div class="shell">
      {/* Lead post */}
      <article
        class="grid overflow-hidden rounded-3xl border border-sand-200 bg-white lg:grid-cols-12"
        data-reveal
      >
        <div class="relative isolate overflow-hidden bg-navy-950 p-9 lg:col-span-5 lg:p-12">
          {
            lead.coverImage?.url && (
              <>
                <SanityImage
                  image={lead.coverImage}
                  alt={lead.coverImage.alt ?? ""}
                  class="absolute inset-0 -z-10 h-full w-full object-cover"
                  sizes="(min-width: 1024px) 42vw, 100vw"
                  loading="eager"
                  fetchpriority="high"
                />
                <div
                  class="absolute inset-0 -z-10 bg-navy-950/70"
                  aria-hidden="true"
                />
              </>
            )
          }
          <p class="eyebrow text-gold-400">Latest</p>
          <h2 class="mt-6 font-display text-display-md font-light leading-tight text-white">
            {lead.title}
          </h2>
          {
            lead.scripture && (
              <p class="mt-4 text-sm italic text-gold-300">{lead.scripture}</p>
            )
          }
        </div>
        <div class="flex flex-col justify-center p-9 lg:col-span-7 lg:p-12">
          <p class="text-lg leading-relaxed text-sand-600">{lead.excerpt}</p>
        </div>
      </article>

      {/* The rest */}
      <div class="mt-8 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((post, i) => (
            <article
              class="card group flex flex-col"
              data-reveal="scale"
              data-reveal-delay={
                i % 3 === 1 ? "100" : i % 3 === 2 ? "180" : undefined
              }
            >
              {post.coverImage?.url && (
                <div class="aspect-[16/10] overflow-hidden">
                  <SanityImage
                    image={post.coverImage}
                    alt={post.coverImage.alt ?? ""}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-8">
              <h2 class="font-display text-2xl font-light leading-snug text-navy-900">
                {post.title}
              </h2>
              {post.scripture && (
                <p class="mt-2 text-sm italic text-gold-800">
                  {post.scripture}
                </p>
              )}
              <p class="mt-4 flex-1 leading-relaxed text-sand-600">
                {post.excerpt}
              </p>
              </div>
              {/* No "Read more" link: the legacy ones went nowhere, and
                  there is no fuller body to link to yet. */}
            </article>
          ))
        }
      </div>

      <p class="mt-14 rounded-2xl border border-sand-300 bg-sand-100 p-6 text-sm leading-relaxed text-sand-600">
        <strong class="text-navy-900">A note on this page:</strong> these are
        the ministry's own posts, carried across in full. The legacy site
        published no dates or authors and its “Read More” links went nowhere,
        so nothing has been invented to fill those gaps. Once the CMS is in
        place, posts get full bodies, dates and their own pages.
      </p>
    </div>
  </section>
</Base>

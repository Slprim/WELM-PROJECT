---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";
import { getPage, getServices } from "../lib/content";

/**
 * Contact, with the legacy Help page folded in — that page held nothing but
 * a phone number, so it did not warrant its own route.
 *
 * Four different phone numbers appear across the legacy site and artwork
 * (0545195648, 0549480591, +233 55 474 2337, +233 55 339 6495). Only the two
 * the ministry puts on its own event graphics are published here; the others
 * need confirming before they go back up.
 */
/**
 * Sunday gatherings, from the CMS.
 *
 * This page used to read the hardcoded list in data/site.ts, so a service
 * added or retimed in Sanity never reached it. There is now more than one
 * Sunday service, so it lists them all rather than singling one out.
 */
const services = await getServices();
const sundays = services.filter(
  (s) => s.where === "In person" && /sunday/i.test(s.when),
);

const reasons = [
  "I'd like to plan a visit",
  "I'd like prayer",
  "I'd like to give or ask about giving",
  "Media or partnership enquiry",
  "Something else",
];

const page = await getPage("contact", {
  eyebrow: "Contact",
  title: "We would love to hear from you",
  lede: "Whether you are planning a first visit or asking for prayer, there is someone here to answer.",
  seoDescription: `Get in touch with ${site.legalName} in ${site.address.city} — visit us on Sunday, request prayer, or send a message.`,
});
---

<Base
  title="Contact"
  description={page.seoDescription}
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lede}
  />

  <section class="section bg-sand-50">
    <div class="shell">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
        {/* ===================== FORM ===================== */}
        <div class="lg:col-span-7">
          <form
            class="rounded-3xl border border-sand-200 bg-white p-8 shadow-e2 sm:p-10"
            data-contact-form
            novalidate
          >
            <h2 class="font-display text-display-md font-light leading-tight">
              Send a message
            </h2>

            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              <div>
                <label for="c-name" class="block text-sm font-medium text-navy-900">
                  Your name
                </label>
                <input
                  id="c-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  class="mt-2 w-full rounded-full border border-sand-300 px-5 py-3 text-navy-900 focus:border-gold-600 focus:outline-none"
                />
              </div>
              <div>
                <label for="c-email" class="block text-sm font-medium text-navy-900">
                  Email
                </label>
                <input
                  id="c-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="mt-2 w-full rounded-full border border-sand-300 px-5 py-3 text-navy-900 focus:border-gold-600 focus:outline-none"
                />
              </div>
            </div>

            <div class="mt-5">
              <label for="c-reason" class="block text-sm font-medium text-navy-900">
                What is this about?
              </label>
              <select
                id="c-reason"
                name="reason"
                class="mt-2 w-full rounded-full border border-sand-300 px-5 py-3 text-navy-900 focus:border-gold-600 focus:outline-none"
              >
                {reasons.map((r) => <option value={r}>{r}</option>)}
              </select>
            </div>

            <div class="mt-5">
              <label for="c-message" class="block text-sm font-medium text-navy-900">
                Message
              </label>
              <textarea
                id="c-message"
                name="message"
                rows="6"
                required
                class="mt-2 w-full rounded-3xl border border-sand-300 px-5 py-4 text-navy-900 focus:border-gold-600 focus:outline-none"
              ></textarea>
            </div>

            <p
              class="mt-4 hidden rounded-2xl bg-red-50 p-4 text-sm text-red-700"
              data-form-error
              role="alert"
            >
              Please fill in your name, a valid email address, and a message.
            </p>

            <button type="submit" class="btn-gold mt-8 w-full !py-4">
              Send message
            </button>

            <p class="mt-5 text-xs leading-relaxed text-sand-500">
              Prayer requests are handled privately by the pastoral team.
            </p>
          </form>

          {/* Honest about the backend, which is not built yet. */}
          <p class="mt-6 rounded-2xl border border-sand-300 bg-sand-100 p-5 text-sm leading-relaxed text-sand-600">
            <strong class="text-navy-900">Note:</strong> this form is not yet
            connected. On the legacy site every form — including prayer
            requests — posted to a single free Formspree inbox. Phase 4 gives
            it a proper backend with pastoral requests kept private.
          </p>
        </div>

        {/* ===================== DETAILS ===================== */}
        <aside class="lg:col-span-5 space-y-6">
          <div class="rounded-3xl bg-navy-950 p-8 text-white" data-reveal="right">
            <p class="eyebrow text-gold-400">Find us</p>
            <a
              href={site.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 block font-display text-2xl font-light text-white transition hover:text-gold-400"
            >
              {site.address.street}
              <span class="mt-1 block text-base text-white/60">
                {site.address.city}, {site.address.country}
              </span>
            </a>

            <div class="mt-8 border-t border-white/10 pt-8">
              <p class="text-xs uppercase tracking-[0.2em] text-gold-400">
                Sundays
              </p>
              {
                sundays.map((s) => (
                  <p class="mt-3 text-white">
                    {s.name}
                    <span class="block text-white/60">{s.time}</span>
                  </p>
                ))
              }
            </div>
          </div>

          <div class="rounded-3xl border border-sand-200 bg-white p-8" data-reveal="right" data-reveal-delay="100">
            <h2 class="font-display text-2xl font-light text-navy-900">
              Call or email
            </h2>
            <div class="mt-6 space-y-3 text-sm">
              {
                site.phones.map((phone) => (
                  <a
                    href={`tel:${phone}`}
                    class="block text-navy-900 transition hover:text-gold-800"
                  >
                    {phone}
                  </a>
                ))
              }
              <a
                href={`mailto:${site.email}`}
                class="block break-all text-navy-900 transition hover:text-gold-800"
              >
                {site.email}
              </a>
            </div>

            <div class="mt-8 flex gap-3 border-t border-sand-200 pt-6">
              {
                [
                  ["Facebook", site.social.facebook],
                  ["Instagram", site.social.instagram],
                  ["YouTube", site.social.youtube],
                ].map(([label, href]) => (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full border border-sand-300 px-4 py-2 text-xs font-medium transition hover:border-gold-600 hover:text-gold-800"
                  >
                    {label}
                  </a>
                ))
              }
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const error = document.querySelector("[data-form-error]");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (!name || !emailOk || !message) {
      error?.classList.remove("hidden");
      return;
    }
    error?.classList.add("hidden");
    // Phase 4 posts this to the serverless handler.
  });
</script>

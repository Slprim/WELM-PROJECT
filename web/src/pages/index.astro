---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import ImageSlideshow from "../components/ImageSlideshow.astro";
import ThemeSection from "../components/ThemeSection.astro";
import ProgrammeCarousel from "../components/ProgrammeCarousel.astro";
import { site } from "../data/site";
import {
  getServices,
  getMonthlyThemes,
  getThemes,
  getProgrammes,
} from "../lib/content";
import { rhythmImages } from "../data/rhythm";
import pastorImage from "../assets/pastor-faith-joseph.jpg";

const services = await getServices();
const monthlyThemes = await getMonthlyThemes();
const yearlyThemes = await getThemes();
const programmes = await getProgrammes();

const sunday = services.find((s) => s.name.startsWith("Revelation"))!;
const daily = services.filter((s) => s.where === "Online");
const gatherings = services.filter((s) => s.where === "In person");
---

<Base
  title="Home"
  description={`${site.legalName} — ${site.tagline}. Join us in ${site.address.city} on Sundays at 8am, or online every day.`}
>
  <HeroCarousel />
  {/* ==================================================================
      VISION
      ================================================================== */}
  <section class="section bg-sand-50">
    <div class="shell">
      <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <p class="eyebrow text-gold-800" data-reveal="left">Our vision</p>
          <h2
            class="mt-7 font-display text-display-lg font-light leading-[1.05]"
            data-reveal="left"
            data-reveal-delay="80"
          >
            That men will live like God
          </h2>
        </div>

        <div class="lg:col-span-7">
          <p
            class="font-display text-2xl font-light leading-snug text-navy-800 sm:text-3xl"
            data-reveal
          >
            We are not building a crowd. We are building people — patiently,
            scripturally, until Christ is formed in them.
          </p>
          <p class="mt-8 leading-relaxed text-sand-600" data-reveal>
            Everything we do runs on that one conviction. The Sunday teaching,
            the 5am declarations, the all-night prayer, the giving — each is a
            means to the same end: a believer who knows who they are and walks
            in it. If you are looking for a place that will take your growth
            seriously, you have found one.
          </p>

          {/* Every figure here is derived from the published schedule.
              Founding year, membership and reach were deliberately left out
              rather than guessed — the client needs to supply those. */}
          <dl class="mt-12 grid gap-8 sm:grid-cols-3" data-reveal>
            {
              [
                [String(services.length), "gatherings each week"],
                ["5am", "first prayer of the day"],
                ["6", "days a week online"],
              ].map(([stat, label]) => (
                <div class="border-t border-sand-200 pt-5">
                  <dt class="font-display text-4xl font-light text-gold-800">
                    {stat}
                  </dt>
                  <dd class="mt-2 text-sm text-sand-500">{label}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <ThemeSection years={yearlyThemes} months={monthlyThemes} />

  <ProgrammeCarousel programmes={programmes} />

  {/* ==================================================================
      RHYTHMS — the full weekly schedule
      ================================================================== */}
  <section class="section bg-navy-950 text-white">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div class="max-w-2xl">
          <p class="eyebrow text-gold-400" data-reveal>The rhythm of the house</p>
          <h2
            class="mt-7 font-display text-display-lg font-light leading-[1.05] text-white"
            data-reveal
          >
            There is a seat for you every day of the week
          </h2>
        </div>
        <a href="/contact" class="btn-ghost" data-reveal>Plan your visit</a>
      </div>

      <div class="mt-16 grid gap-6 lg:grid-cols-3">
        <!-- Feature card: Sunday -->
        <article
          class="group relative isolate overflow-hidden rounded-3xl lg:col-span-2 lg:row-span-2"
          data-reveal
        >
          {/* Photos come from the Sunday service record in Sanity when any
              are uploaded, otherwise from the legacy highlight set. Two or
              more and they crossfade on their own. Parallax is dropped here:
              it and the slideshow would fight over the same transform. */}
          <div class="absolute inset-0 -z-10">
            <ImageSlideshow
              remote={sunday.images}
              local={rhythmImages}
              alt="The congregation gathered for a Sunday service"
              class="object-cover"
              sizes="(min-width: 1024px) 66vw, 100vw"
              interval={5000}
            />
          </div>
          <div
            class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-950 via-navy-950/70 to-transparent"
          >
          </div>

          <div class="flex min-h-[26rem] flex-col justify-end p-9 lg:min-h-[34rem]">
            <p class="text-xs uppercase tracking-[0.2em] text-gold-400">
              {sunday.when}
            </p>
            <h3 class="mt-4 font-display text-4xl font-light text-white">
              {sunday.name}
            </h3>
            <p class="mt-3 max-w-md text-white/70">{sunday.note}</p>
            <p class="mt-6 text-sm font-medium text-gold-300">
              {sunday.time} · {sunday.where}
            </p>
          </div>
        </article>

        <!-- Daily online -->
        <article
          class="rounded-3xl border border-white/10 bg-navy-900 p-8"
          data-reveal="scale"
          data-reveal-delay="100"
        >
          <p class="text-xs uppercase tracking-[0.2em] text-gold-400">
            Daily · Online
          </p>
          <ul class="mt-7 space-y-6">
            {
              daily.map((s) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-white/10 pb-5 last:border-0 last:pb-0">
                  <span class="font-display text-xl font-light text-white">
                    {s.name}
                  </span>
                  <span class="shrink-0 text-sm text-white/50">{s.time}</span>
                </li>
              ))
            }
          </ul>
        </article>

        <!-- Monthly -->
        <article
          class="rounded-3xl border border-gold-500/25 bg-gradient-to-br from-navy-800 to-navy-900 p-8"
          data-reveal="scale"
          data-reveal-delay="180"
        >
          <p class="text-xs uppercase tracking-[0.2em] text-gold-400">
            In person
          </p>
          <ul class="mt-7 space-y-6">
            {
              gatherings
                .filter((s) => !s.name.startsWith("Revelation"))
                .map((s) => (
                  <li class="border-b border-white/10 pb-5 last:border-0 last:pb-0">
                    <span class="block font-display text-xl font-light text-white">
                      {s.name}
                    </span>
                    <span class="mt-1 block text-sm text-white/50">
                      {s.when} · {s.time}
                    </span>
                  </li>
                ))
            }
          </ul>
        </article>
      </div>
    </div>
  </section>

  {/* ==================================================================
      PASTOR
      ================================================================== */}
  <section class="section bg-sand-100">
    <div class="shell">
      <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5" data-reveal="scale">
          <div class="relative">
            <div
              class="absolute -inset-5 -z-10 rounded-3xl border-2 border-gold-400/60"
              aria-hidden="true"
            >
            </div>
            <Image
              src={pastorImage}
              alt="Pastor Faith Joseph"
              class="w-full rounded-2xl object-cover shadow-e3"
              widths={[480, 760, 1100]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="lazy"
            />
          </div>
        </div>

        <div class="lg:col-span-7">
          <p class="eyebrow text-gold-800" data-reveal="right">Our leader</p>
          <h2
            class="mt-7 font-display text-display-lg font-light leading-[1.05]"
            data-reveal="right"
            data-reveal-delay="80"
          >
            Pastor Faith Joseph
          </h2>
          <p class="mt-7 text-lg leading-relaxed text-sand-600" data-reveal>
            Founder and leader of Words of Eternal Life Ministries and Faith
            Joseph Ministries. A teacher of the scriptures, a preacher of the
            gospel of Christ, and an author whose work has shaped believers
            across Ghana and beyond.
          </p>

          <ul class="mt-9 flex flex-wrap gap-3" data-reveal>
            {
              ["Teacher", "Preacher", "Author"].map((role) => (
                <li class="rounded-full border border-sand-300 px-5 py-2 text-sm text-sand-600">
                  {role}
                </li>
              ))
            }
          </ul>

          <div class="mt-10" data-reveal>
            <a href="/about/pastor-faith-joseph" class="btn-outline">
              Read his story
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ==================================================================
      GIVE
      ================================================================== */}
  {/* The band carries the true brand navy, but as a gradient into the deeper
      navy rather than a flat #001870 field — at full bleed the pure hue
      overpowered every other section. */}
  <section
    class="relative isolate overflow-hidden bg-gradient-to-br from-navy-600 via-navy-700 to-navy-900"
  >
    <div
      class="absolute inset-0 -z-10 opacity-15"
      style="background-image: radial-gradient(circle at 15% 15%, #dfb163 0, transparent 42%), radial-gradient(circle at 85% 85%, #dfb163 0, transparent 38%);"
      aria-hidden="true"
    >
    </div>

    <div class="shell py-24 sm:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow justify-center text-gold-300" data-reveal>
          Metadidomi
        </p>
        <h2
          class="mt-7 font-display text-display-lg font-light leading-[1.05] text-white"
          data-reveal
        >
          Every seed sown here goes somewhere
        </h2>
        <p class="mt-7 text-lg leading-relaxed text-white/75" data-reveal>
          Your giving funds the teaching, the outreach and the running of the
          house. Give once or set up a standing gift — by mobile money or card,
          in a few taps.
        </p>
        <div
          class="mt-11 flex flex-wrap justify-center gap-4"
          data-reveal
        >
          <a href="/give" class="btn-gold">Give now</a>
          <a href="/about/mission-and-vision" class="btn-ghost">
            Where it goes
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { mission } from "../../data/about";
import { getStatementOfFaith, getPage } from "../../lib/content";

const statementOfFaith = await getStatementOfFaith();

const page = await getPage("statement-of-faith", {
  eyebrow: "Statement of Faith",
  title: "What this house holds to",
  lede: "Ten articles, each anchored in scripture.",
  seoDescription:
    "The ten articles Words of Eternal Life Ministries holds to, and the scriptures behind each one.",
});
---

<Base
  title="Statement of Faith"
  description={page.seoDescription}
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lede}
  />

  <section class="section bg-sand-50">
    <div class="shell">
      <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <dl class="space-y-8">
              <div data-reveal="left">
                <dt class="text-xs uppercase tracking-[0.2em] text-gold-800">
                  Mission statement
                </dt>
                <dd class="mt-3 font-display text-2xl font-light leading-snug text-navy-900">
                  {mission.statement}
                </dd>
              </div>
              <div data-reveal="left" data-reveal-delay="100">
                <dt class="text-xs uppercase tracking-[0.2em] text-gold-800">
                  Tagline
                </dt>
                <dd class="mt-3 font-display text-2xl font-light leading-snug text-navy-900">
                  {mission.tagline}
                </dd>
              </div>
            </dl>
          </div>
        </aside>

        <div class="lg:col-span-8">
          <ol class="space-y-px overflow-hidden rounded-3xl border border-sand-200 bg-sand-200">
            {
              statementOfFaith.map((item, i) => (
                <li
                  class="flex gap-6 bg-white p-7 sm:p-8"
                  data-reveal
                  data-reveal-delay={i % 2 ? "100" : undefined}
                >
                  <span
                    class="font-display text-2xl font-light text-gold-500"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h2 class="font-display text-xl font-light leading-snug text-navy-900">
                      {item.article}
                    </h2>
                    <p class="mt-2 text-sm italic text-sand-500">{item.refs}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>
</Base>

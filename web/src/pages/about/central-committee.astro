---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import SanityImage from "../../components/SanityImage.astro";
import { getCommitteeWithPhotos, getPage } from "../../lib/content";
import { portraits } from "../../data/people";

const committee = await getCommitteeWithPhotos();
const page = await getPage("central-committee", {
  eyebrow: "Central Committee",
  title: "The governing body of the ministry",
  lede: "Constituted in 2019 to oversee the work of the house.",
  seoDescription:
    "The Central Committee is the governing body of Words of Eternal Life Ministries, constituted in 2019.",
});

/** Initials are the last resort, for anyone with no portrait at all. */
const initials = (name: string) =>
  name
    .replace(/^(Dr\.|Pastor|Mrs|Mr\.?|Prophet)\s+/i, "")
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0])
    .join("");

/**
 * Three sources, in order of preference: a portrait uploaded to Sanity, the
 * photo carried over from the legacy site, then initials.
 */
const withPhoto = committee.map((member) => ({
  ...member,
  local: portraits[member.name] ?? null,
}));
---

<Base title={page.title} description={page.seoDescription}>
  <PageHeader eyebrow={page.eyebrow} title={page.title} lede={page.lede} />

  <section class="section bg-sand-50">
    <div class="shell">
      <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
        {
          withPhoto.map((member, i) => (
            <article
              class="card group overflow-hidden"
              data-reveal="scale"
              data-reveal-delay={
                i % 4 === 1
                  ? "80"
                  : i % 4 === 2
                    ? "160"
                    : i % 4 === 3
                      ? "240"
                      : undefined
              }
            >
              <div class="relative aspect-[3/4] overflow-hidden bg-navy-900">
                {member.photo?.url ? (
                  <SanityImage
                    image={member.photo}
                    alt={member.photo.alt ?? member.name}
                    class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                    sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 100vw"
                  />
                ) : member.local ? (
                  <Image
                    src={member.local}
                    alt={member.name}
                    class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                    widths={[280, 460, 700]}
                    sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 100vw"
                    loading={i < 4 ? "eager" : "lazy"}
                  />
                ) : (
                  <span
                    class="grid h-full w-full place-items-center font-display text-5xl font-light text-gold-400"
                    aria-hidden="true"
                  >
                    {initials(member.name)}
                  </span>
                )}
                <div
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-navy-950/85 to-transparent"
                  aria-hidden="true"
                />
                <div class="absolute inset-x-0 bottom-0 p-5">
                  <h2 class="font-display text-xl font-light leading-snug text-white">
                    {member.name}
                  </h2>
                  <p class="mt-1 text-sm text-gold-300">{member.role}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

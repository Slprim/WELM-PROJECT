---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { site } from "../../data/site";
import { mission } from "../../data/about";
import { getHistory, getTestimonies, getPage } from "../../lib/content";

const history = await getHistory();
const testimonies = await getTestimonies();

const sections = [
  {
    href: "/about/pastor-faith-joseph",
    title: "Pastor Faith Joseph",
    body: "The founder and head pastor of the house.",
  },
  {
    href: "/about/statement-of-faith",
    title: "Statement of Faith",
    body: "The ten things this house holds to, and the scriptures behind them.",
  },
  {
    href: "/about/central-committee",
    title: "Central Committee",
    body: "The governing body of the ministry, constituted in 2019.",
  },
  {
    href: "/about/mission-and-vision",
    title: "Mission & Vision",
    body: "Why the house exists and where it is going.",
  },
];

const page = await getPage("about", {
  eyebrow: "About the house",
  title: "It began with fifty people in a café",
  lede: "Words of Eternal Life Ministries has been gathering in Accra since 2012. This is how it started, and what it has become.",
  seoDescription: `${site.legalName} was inaugurated in Accra in August 2012. Read how the house began, what it believes, and who leads it.`,
});
---

<Base
  title="About"
  description={page.seoDescription}
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lede}
  />

  {/* ================= HISTORY ================= */}
  <section class="section bg-sand-50">
    <div class="shell">
      <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4">
          <p class="eyebrow text-gold-800" data-reveal="left">Our story</p>
          <h2
            class="mt-7 font-display text-display-lg font-light leading-[1.05]"
            data-reveal="left"
            data-reveal-delay="80"
          >
            The foundation of the ministry
          </h2>
          <p class="mt-7 leading-relaxed text-sand-600" data-reveal="left" data-reveal-delay="160">
            This ministry was founded by the Holy Spirit. What follows is the
            record of how it came to be.
          </p>
        </div>

        <div class="lg:col-span-8">
          <ol class="relative border-l border-sand-300 pl-8 sm:pl-12">
            {
              history.map((item, i) => (
                <li
                  class="relative pb-12 last:pb-0"
                  data-reveal
                  data-reveal-delay={i % 2 ? "100" : undefined}
                >
                  <span
                    class="absolute -left-[2.05rem] top-2 h-3 w-3 rounded-full border-2 border-gold-500 bg-sand-50 sm:-left-[3.05rem]"
                    aria-hidden="true"
                  />
                  <p class="text-xs uppercase tracking-[0.2em] text-gold-800">
                    {item.date}
                  </p>
                  <h3 class="mt-3 font-display text-2xl font-light text-navy-900">
                    {item.title}
                  </h3>
                  <p class="mt-3 leading-relaxed text-sand-600">{item.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* ================= SCRIPTURE BAND ================= */}
  <section class="bg-navy-950 py-24 sm:py-32">
    <div class="shell text-center">
      <p
        class="mx-auto max-w-3xl font-display text-display-md font-light italic leading-tight text-white"
        data-reveal="scale"
      >
        “{mission.scripture.split("—")[0].trim()}”
      </p>
      <p class="mt-6 text-sm uppercase tracking-[0.22em] text-gold-400" data-reveal>
        1 John 4:17
      </p>
    </div>
  </section>

  {/* ================= SUB-SECTIONS ================= */}
  <section class="section bg-sand-100">
    <div class="shell">
      <h2 class="font-display text-display-md font-light" data-reveal>
        Go deeper
      </h2>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          sections.map((s, i) => (
            <a
              href={s.href}
              class="card group flex flex-col justify-between p-8"
              data-reveal="scale"
              data-reveal-delay={i % 2 ? "100" : undefined}
            >
              <div>
                <h3 class="font-display text-2xl font-light text-navy-900">
                  {s.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-sand-600">
                  {s.body}
                </p>
              </div>
              <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-gold-800">
                Read more
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ================= TESTIMONIES ================= */}
  <section class="section bg-sand-50">
    <div class="shell">
      <p class="eyebrow text-gold-800" data-reveal>Testimonies</p>
      <h2
        class="mt-7 max-w-2xl font-display text-display-lg font-light leading-[1.05]"
        data-reveal
      >
        What the Lord has done
      </h2>

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          testimonies.map((t, i) => (
            <blockquote
              class="rounded-3xl border border-sand-200 bg-white p-8"
              data-reveal="scale"
              data-reveal-delay={i % 2 ? "100" : undefined}
            >
              <p class="leading-relaxed text-sand-600">“{t.body}”</p>
              <footer class="mt-6 text-sm font-semibold text-navy-900">
                {t.name}
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>
</Base>

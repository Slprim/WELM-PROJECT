---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import SanityImage from "../components/SanityImage.astro";
import YouTubeFeed from "../components/YouTubeFeed.astro";
import { site } from "../data/site";
import { mediaItems as localItems, series } from "../data/media";
import { getMediaItems, getPage } from "../lib/content";

const page = await getPage("sermons", {
  eyebrow: "Media Library",
  title: "Catch up on the word",
  lede: "Every teaching, conference and theme the house has walked through — in one place.",
  seoDescription: `Teachings, conferences and yearly themes from ${site.legalName} in ${site.address.city}.`,
});

/**
 * Media comes from Sanity when anything is published there, otherwise from
 * the items recovered from the legacy artwork. The two carry images
 * differently — Sanity gives a CDN URL, the local set gives a bundled asset —
 * so each item is tagged with which renderer to use.
 */
const remote = await getMediaItems();

type Card = {
  slug: string;
  title: string;
  kind: string;
  series: string;
  speaker: string | null;
  dateLabel: string;
  scripture: string | null;
  summary: string | null;
  url: string | null;
  remoteImage: { url: string | null; alt?: string | null; width?: number | null; height?: number | null } | null;
  localImage: ImageMetadata | null;
};

const cards: Card[] = remote
  ? remote.map((m) => ({
      slug: m.slug,
      title: m.title,
      kind: m.kind,
      series: m.series,
      speaker: m.speaker,
      dateLabel: m.dateLabel ?? (m.date ? new Date(m.date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : "Undated"),
      scripture: m.scripture,
      summary: m.summary,
      url: m.url,
      remoteImage: m.image ?? null,
      localImage: null,
    }))
  : localItems.map((m) => ({
      slug: m.slug,
      title: m.title,
      kind: m.kind,
      series: m.series,
      speaker: m.speaker,
      dateLabel: m.dateLabel,
      scripture: m.scripture,
      summary: m.summary,
      url: m.url,
      remoteImage: null,
      localImage: m.image,
    }));

const featured = cards[0];
const rest = cards.slice(1);

const kindLabel: Record<string, string> = {
  video: "Video",
  audio: "Audio",
  series: "Series",
};
---

<Base title={page.title} description={page.seoDescription}>
  <PageHeader eyebrow={page.eyebrow} title={page.title} lede={page.lede} />

  {/* ==================================================================
      FEATURED
      ================================================================== */}
  <section class="bg-sand-50 pb-20 pt-4 sm:pb-28">
    <div class="shell">
      <article
        class="group relative isolate grid overflow-hidden rounded-3xl bg-navy-950 lg:grid-cols-2"
        data-reveal
        data-parallax-root
      >
        <div class="relative min-h-[22rem] overflow-hidden lg:min-h-[30rem]">
          {
            featured.remoteImage?.url ? (
              <SanityImage
                image={featured.remoteImage}
                alt={featured.remoteImage.alt ?? featured.title}
                class="absolute inset-0 h-full w-full object-cover"
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="eager"
                fetchpriority="high"
              />
            ) : featured.localImage ? (
              <Image
                src={featured.localImage}
                alt={featured.title}
                class="absolute inset-0 h-full w-full object-cover"
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="eager"
                data-parallax
              />
            ) : null
          }
          <div
            class="absolute inset-0 bg-gradient-to-t from-navy-950/70 to-transparent lg:bg-gradient-to-r"
          >
          </div>
        </div>

        <div class="flex flex-col justify-center p-9 lg:p-14">
          <p class="eyebrow text-gold-400">Latest · {featured.series}</p>
          <h2
            class="mt-6 font-display text-display-md font-light leading-tight text-white"
          >
            {featured.title}
          </h2>
          {
            featured.summary && (
              <p class="mt-5 leading-relaxed text-white/70">{featured.summary}</p>
            )
          }
          <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 text-sm">
            {
              featured.speaker && (
                <div>
                  <dt class="text-white/40">Speaker</dt>
                  <dd class="mt-1 text-white">{featured.speaker}</dd>
                </div>
              )
            }
            <div>
              <dt class="text-white/40">When</dt>
              <dd class="mt-1 text-white">{featured.dateLabel}</dd>
            </div>
          </dl>

          <div class="mt-10 flex flex-wrap gap-3">
            {
              featured.url ? (
                <a
                  href={featured.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-gold"
                >
                  {featured.kind === "audio" ? "Listen now" : "Watch now"}
                </a>
              ) : (
                <span class="btn border border-white/15 text-white/50">
                  Recording not yet published
                </span>
              )
            }
            <a
              href={site.social.youtube}
              class="btn-ghost"
              target="_blank"
              rel="noopener noreferrer"
            >
              Watch on YouTube
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  {/* ==================================================================
      LIBRARY
      ================================================================== */}
  <section class="section bg-sand-100 pt-0">
    <div class="shell">
      <div
        class="flex flex-wrap items-end justify-between gap-6 border-b border-sand-300 pb-8"
      >
        <div>
          <h2 class="font-display text-display-md font-light leading-tight">
            The library
          </h2>
          <p class="mt-2 text-sm text-sand-500">
            <span data-result-count>{rest.length}</span> items
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <label for="media-search" class="sr-only">Search the library</label>
          <input
            id="media-search"
            type="search"
            placeholder="Search teachings…"
            class="w-full rounded-full border border-sand-300 bg-white px-5 py-2.5 text-sm text-navy-900 placeholder:text-sand-400 focus:border-gold-600 focus:outline-none sm:w-64"
            data-media-search
          />
        </div>
      </div>

      <div
        class="mt-8 flex flex-wrap gap-2"
        role="group"
        aria-label="Filter by series"
      >
        <button
          type="button"
          class="media-filter rounded-full border border-navy-900/15 px-5 py-2 text-sm transition"
          data-filter="all"
          aria-pressed="true"
        >
          All
        </button>
        {
          series.map((s) => (
            <button
              type="button"
              class="media-filter rounded-full border border-navy-900/15 px-5 py-2 text-sm transition"
              data-filter={s}
              aria-pressed="false"
            >
              {s}
            </button>
          ))
        }
      </div>

      <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3" data-media-grid>
        {
          rest.map((item, i) => {
            // A card with a link is a real link; one without stays a plain
            // article rather than an anchor that goes nowhere.
            const Tag = item.url ? "a" : "article";
            return (
              <Tag
                class="card group flex flex-col"
                data-reveal="scale"
                data-reveal-delay={
                  i % 3 === 1 ? "100" : i % 3 === 2 ? "180" : undefined
                }
                data-series={item.series}
                data-title={item.title.toLowerCase()}
                data-speaker={(item.speaker ?? "").toLowerCase()}
                {...(item.url
                  ? { href: item.url, target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                <div class="relative aspect-[4/3] overflow-hidden">
                  {item.remoteImage?.url ? (
                    <SanityImage
                      image={item.remoteImage}
                      alt={item.remoteImage.alt ?? item.title}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                    />
                  ) : item.localImage ? (
                    <Image
                      src={item.localImage}
                      alt={item.title}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                      widths={[320, 560, 800]}
                      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                      loading="lazy"
                    />
                  ) : null}

                  <span class="absolute left-4 top-4 rounded-full bg-navy-950/80 px-3 py-1 text-[0.65rem] uppercase tracking-[0.15em] text-gold-300 backdrop-blur-sm">
                    {kindLabel[item.kind] ?? item.kind}
                  </span>

                  {item.url && (
                    <span
                      class="absolute inset-0 grid place-items-center bg-navy-950/45 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                      aria-hidden="true"
                    >
                      <span class="grid h-16 w-16 place-items-center rounded-full border-2 border-gold-400 text-gold-400">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-6 w-6">
                          <path d="M7 4l12 8-12 8z" />
                        </svg>
                      </span>
                    </span>
                  )}
                </div>

                <div class="flex flex-1 flex-col p-7">
                  <p class="text-[0.65rem] uppercase tracking-[0.18em] text-gold-800">
                    {item.series}
                  </p>
                  <h3 class="mt-3 font-display text-2xl font-light leading-snug text-navy-900 transition group-hover:text-gold-800">
                    {item.title}
                  </h3>
                  {item.scripture && (
                    <p class="mt-2 text-sm italic text-sand-500">
                      {item.scripture}
                    </p>
                  )}
                  {item.summary && (
                    <p class="mt-3 text-sm leading-relaxed text-sand-600">
                      {item.summary}
                    </p>
                  )}

                  <div class="mt-auto flex items-center justify-between gap-4 pt-6 text-sm">
                    <span class="text-sand-500">{item.dateLabel}</span>
                    {item.speaker && (
                      <span class="text-right text-sand-500">{item.speaker}</span>
                    )}
                  </div>
                </div>
              </Tag>
            );
          })
        }
      </div>

      <p
        class="mt-16 hidden text-center font-display text-2xl font-light text-sand-500"
        data-empty-state
      >
        Nothing matches that search yet.
      </p>
    </div>
  </section>

  {/* ==================================================================
      LATEST FROM YOUTUBE

      Replaces the Elfsight gallery the legacy Media Library used. The list
      is fetched at runtime, so a sermon posted this morning appears without
      anyone rebuilding the site — unlike the curated grid above, which is
      part of the build. Playback happens here rather than on YouTube.
      ================================================================== */}
  <section class="section bg-sand-50">
    <div class="shell">
      <YouTubeFeed
        limit={12}
        heading="Latest from the channel"
        intro="Every new teaching, as it is posted. Press play to watch here — nothing loads from YouTube until you do."
      />
    </div>
  </section>

  {/* ==================================================================
      KOG RADIO — carried over from the legacy Media Library page
      ================================================================== */}
  <section class="section bg-navy-950 text-white">
    <div class="shell">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-gold-400" data-reveal="left">On air</p>
          <h2
            class="mt-7 font-display text-display-lg font-light leading-[1.05] text-white"
            data-reveal="left"
            data-reveal-delay="80"
          >
            K.O.G Radio
          </h2>
          <p
            class="mt-7 leading-relaxed text-white/70"
            data-reveal="left"
            data-reveal-delay="160"
          >
            The ministry's own station, streaming around the clock. Godhood, the
            live radio broadcast with Dr. Faith Joseph, goes out every Monday.
          </p>
        </div>

        <div class="lg:col-span-7" data-reveal="right">
          <div class="overflow-hidden rounded-3xl border border-white/10 bg-navy-900 p-2">
            <iframe
              src="https://zeno.fm/player/kingdom-of-gods-radio"
              title="K.O.G Radio live stream"
              class="h-[220px] w-full rounded-2xl"
              loading="lazy"
              frameborder="0"
              scrolling="no"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Client-side filter + search. The dataset is small enough that filtering
  // in the browser beats a round trip; when the library grows past a few
  // hundred items this should move to paginated routes.
  const grid = document.querySelector("[data-media-grid]");
  const search = document.querySelector<HTMLInputElement>("[data-media-search]");
  const filters = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".media-filter"),
  );
  const countEl = document.querySelector("[data-result-count]");
  const emptyEl = document.querySelector("[data-empty-state]");

  if (grid) {
    // Cards are <a> when they link out and <article> when they do not.
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>("[data-series]"),
    );
    let activeSeries = "all";

    const apply = () => {
      const q = (search?.value ?? "").trim().toLowerCase();
      let shown = 0;

      cards.forEach((card) => {
        const matchesSeries =
          activeSeries === "all" || card.dataset.series === activeSeries;
        const matchesQuery =
          !q ||
          (card.dataset.title ?? "").includes(q) ||
          (card.dataset.speaker ?? "").includes(q) ||
          (card.dataset.series ?? "").toLowerCase().includes(q);

        const visible = matchesSeries && matchesQuery;
        card.hidden = !visible;
        if (visible) shown++;
      });

      if (countEl) countEl.textContent = String(shown);
      if (emptyEl) emptyEl.classList.toggle("hidden", shown > 0);
    };

    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeSeries = btn.dataset.filter ?? "all";
        filters.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        apply();
      });
    });

    search?.addEventListener("input", apply);
    apply();
  }
</script>

<style>
  .media-filter[aria-pressed="true"] {
    background-color: var(--color-navy-900);
    border-color: var(--color-navy-900);
    color: white;
  }
  .media-filter[aria-pressed="false"]:hover {
    border-color: var(--color-gold-600);
    color: var(--color-gold-800);
  }
  /* `hidden` must win over the card's flex display when filtering. */
  [data-media-grid] [hidden] {
    display: none !important;
  }
</style>

---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { site, services } from "../data/site";
import { getPage } from "../lib/content";

/**
 * The legacy LiveStream page embedded two `youtube.com/embed/live_stream?
 * channel=…` URLs and rendered "Error: Embedded data could not be
 * displayed." That endpoint only serves a player while a stream is actually
 * live, and it breaks when the channel has no active broadcast.
 *
 * This page instead links out by default and only embeds on request, so it
 * never shows a broken player. A real live/offline badge needs the YouTube
 * Data API, which is Phase 3.
 */
const channel = site.youtubeChannels.primary;
const online = services.filter((s) => s.where === "Clubhouse");

const page = await getPage("live", {
  eyebrow: "Live",
  title: "Join us from wherever you are",
  lede: "Sunday services stream on YouTube. The daily gatherings run on Clubhouse.",
  seoDescription: `Join ${site.legalName} live from anywhere — Sunday services, the 5am Declaration Hour and daily teachings.`,
});
---

<Base
  title="Live"
  description={page.seoDescription}
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lede}
  />

  <section class="section bg-sand-50">
    <div class="shell">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-8">
          <div
            class="relative overflow-hidden rounded-3xl bg-navy-950"
            data-reveal
          >
            <div class="aspect-video w-full" data-player>
              <!-- Click-to-load keeps YouTube's cookies and ~1MB of player
                   JS off the page until someone actually asks for it. -->
              <button
                type="button"
                class="group grid h-full w-full place-items-center bg-navy-900 transition hover:bg-navy-800"
                data-load-player
                data-channel={channel}
              >
                <span class="flex flex-col items-center gap-5 p-8 text-center">
                  <span
                    class="grid h-20 w-20 place-items-center rounded-full border-2 border-gold-500 text-gold-500 transition group-hover:scale-105 group-hover:bg-gold-500 group-hover:text-navy-950"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-8 w-8">
                      <path d="M7 4l12 8-12 8z"></path>
                    </svg>
                  </span>
                  <span class="font-display text-2xl font-light text-white">
                    Load the live player
                  </span>
                  <span class="max-w-sm text-sm text-white/60">
                    If a service is streaming now it will start here. If not,
                    you will see the channel's most recent broadcast.
                  </span>
                </span>
              </button>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={site.social.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline"
            >
              Open YouTube channel
            </a>
            <a
              href={site.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline"
            >
              Watch on Facebook
            </a>
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="rounded-3xl bg-navy-950 p-8 text-white" data-reveal="right">
            <p class="eyebrow text-gold-400">On air</p>
            <h2 class="mt-6 font-display text-3xl font-light text-white">
              Every day of the week
            </h2>
            <ul class="mt-8 space-y-5">
              {
                online.map((s) => (
                  <li class="border-b border-white/10 pb-5 last:border-0 last:pb-0">
                    <span class="block font-display text-xl font-light">
                      {s.name}
                    </span>
                    <span class="mt-1 block text-sm text-white/60">
                      {s.when} · {s.time}
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-8 text-sm leading-relaxed text-white/60">
              The daily gatherings run on Clubhouse rather than YouTube.
            </p>
          </div>

          <div class="mt-6 rounded-3xl border border-sand-200 bg-white p-8" data-reveal="right" data-reveal-delay="100">
            <h3 class="font-display text-2xl font-light text-navy-900">
              Rather come in person?
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-sand-600">
              Revelation Sunday Service runs 8:00 – 10:00 am at the Cambridge
              Centre of Excellence, Dzorwulu.
            </p>
            <a href="/contact" class="btn-outline mt-6">Plan your visit</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  const trigger = document.querySelector<HTMLElement>("[data-load-player]");
  const holder = document.querySelector<HTMLElement>("[data-player]");

  trigger?.addEventListener("click", () => {
    const channel = trigger.dataset.channel;
    if (!holder || !channel) return;

    const frame = document.createElement("iframe");
    frame.src = `https://www.youtube.com/embed/live_stream?channel=${channel}&autoplay=1`;
    frame.title = "Live stream";
    frame.className = "h-full w-full";
    frame.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
    frame.allowFullscreen = true;
    frame.referrerPolicy = "strict-origin-when-cross-origin";

    holder.replaceChildren(frame);
  });
</script>

---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";
import { getPage, getServices } from "../lib/content";

/**
 * The legacy LiveStream page embedded two `youtube.com/embed/live_stream?
 * channel=…` URLs and rendered "Error: Embedded data could not be
 * displayed." That endpoint only serves a player while a stream is actually
 * live, and it breaks when the channel has no active broadcast.
 *
 * The page now asks `/api/youtube/feed.php` whether the channel is on air and
 * shows the state that is actually true, so a broken player is never offered.
 * No YouTube Data API key is involved: the check reads
 * liveBroadcastDetails.isLiveNow from the video's public watch page, and the
 * answer is cached server-side.
 *
 * `live_stream?channel=` is still the address used for a running broadcast.
 * It is permanent — it always resolves to whatever that channel is streaming,
 * so nobody has to paste a new link each week.
 */
const channel = site.youtubeChannels.streaming;
const services = await getServices();
const online = services.filter((s) => s.where !== "In person");

const page = await getPage("live", {
  eyebrow: "Live",
  title: "Join us from wherever you are",
  lede: "Sunday services stream on YouTube, and there is a gathering every weekday.",
  seoDescription: `Join ${site.legalName} live from anywhere — Sunday services, the 5am Declaration Hour and daily teachings.`,
});
---

<Base
  title="Live"
  description={page.seoDescription}
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lede}
  />

  <section class="section bg-sand-50">
    <div class="shell">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-8">
          <div
            class="relative overflow-hidden rounded-3xl bg-navy-950"
            data-reveal
          >
            <div class="aspect-video w-full" data-player>
              <!--
                Three states, decided by /api/youtube/feed.php rather than
                guessed. The old button could only offer "load the player and
                find out", because a static page cannot know whether a service
                is on air. Click-to-load is kept in every state: YouTube's
                cookies and ~1MB of player JS stay off the page until someone
                actually asks for it.
              -->
              <div
                class="grid h-full w-full place-items-center bg-navy-900"
                data-state="checking"
              >
                <span class="flex flex-col items-center gap-4 p-8 text-center">
                  <span
                    class="h-10 w-10 animate-spin rounded-full border-2 border-white/20 border-t-gold-500"
                    aria-hidden="true"></span>
                  <span class="text-sm text-white/60">Checking if we are live…</span>
                </span>
              </div>

              <button
                type="button"
                class="group hidden h-full w-full place-items-center bg-navy-900 transition hover:bg-navy-800"
                data-state="live"
                data-channel={channel}
                hidden
              >
                <span class="flex flex-col items-center gap-5 p-8 text-center">
                  <span
                    class="inline-flex items-center gap-2 rounded-full bg-red-600 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white"
                  >
                    <span class="live-dot h-2 w-2 rounded-full bg-white"></span>
                    Live now
                  </span>
                  <span
                    class="grid h-20 w-20 place-items-center rounded-full border-2 border-gold-500 text-gold-500 transition group-hover:scale-105 group-hover:bg-gold-500 group-hover:text-navy-950"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-8 w-8">
                      <path d="M7 4l12 8-12 8z"></path>
                    </svg>
                  </span>
                  <span
                    class="max-w-md font-display text-2xl font-light text-white"
                    data-live-title>We are live</span
                  >
                  <span class="text-sm text-white/60">Press play to join the service</span>
                </span>
              </button>

              <button
                type="button"
                class="group hidden h-full w-full place-items-center bg-navy-900 transition hover:bg-navy-800"
                data-state="offline"
                data-channel={channel}
                hidden
              >
                <span class="flex flex-col items-center gap-5 p-8 text-center">
                  <span
                    class="grid h-20 w-20 place-items-center rounded-full border-2 border-white/25 text-white/60 transition group-hover:border-gold-500 group-hover:text-gold-500"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-8 w-8">
                      <path d="M7 4l12 8-12 8z"></path>
                    </svg>
                  </span>
                  <span class="font-display text-2xl font-light text-white">
                    Not live at the moment
                  </span>
                  <span
                    class="max-w-sm text-sm text-white/60"
                    data-offline-note
                    >Watch the most recent broadcast, or see the times below.</span
                  >
                </span>
              </button>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={site.social.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline"
            >
              Open YouTube channel
            </a>
            <a
              href={site.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline"
            >
              Watch on Facebook
            </a>
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="rounded-3xl bg-navy-950 p-8 text-white" data-reveal="right">
            <p class="eyebrow text-gold-400">On air</p>
            <h2 class="mt-6 font-display text-3xl font-light text-white">
              Every day of the week
            </h2>
            <ul class="mt-8 space-y-5">
              {
                online.map((s) => (
                  <li class="border-b border-white/10 pb-5 last:border-0 last:pb-0">
                    <span class="block font-display text-xl font-light">
                      {s.name}
                    </span>
                    <span class="mt-1 block text-sm text-white/60">
                      {s.when} · {s.time}
                    </span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-8 text-sm leading-relaxed text-white/60">
              Times are Ghana time (GMT).
            </p>
          </div>

          <div class="mt-6 rounded-3xl border border-sand-200 bg-white p-8" data-reveal="right" data-reveal-delay="100">
            <h3 class="font-display text-2xl font-light text-navy-900">
              Rather come in person?
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-sand-600">
              Revelation Sunday Service runs 8:00 – 10:00 am at {site.address.street},
              {" "}{site.address.city}.
            </p>
            <a href="/contact" class="btn-outline mt-6">Plan your visit</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  /**
   * Ask the server whether the channel is on air, then show the matching
   * state. The endpoint caches its answer, so a congregation arriving at once
   * costs one check rather than one each.
   *
   * The page is useful without this: if the check fails we fall through to the
   * offline state, which still plays the channel's most recent broadcast.
   */
  const holder = document.querySelector<HTMLElement>("[data-player]");

  const show = (name: string) => {
    holder?.querySelectorAll<HTMLElement>("[data-state]").forEach((el) => {
      const match = el.dataset.state === name;
      el.hidden = !match;
      el.classList.toggle("hidden", !match);
      // The buttons are `grid` when visible; `hidden` must win when not.
      if (match && el.tagName === "BUTTON") el.classList.add("grid");
    });
  };

  /**
   * `live_stream?channel=` is the permanent address of whatever that channel
   * is broadcasting — it never changes, so nobody has to paste a new link each
   * week. When a specific video is known, that is used instead, since it also
   * works once the broadcast has ended.
   */
  const play = (videoId: string | null, channel: string | undefined) => {
    if (!holder) return;
    const src = videoId
      ? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1`
      : `https://www.youtube.com/embed/live_stream?channel=${channel}&autoplay=1`;

    const frame = document.createElement("iframe");
    frame.src = src;
    frame.title = "Live stream";
    frame.className = "h-full w-full";
    frame.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
    frame.allowFullscreen = true;
    frame.referrerPolicy = "strict-origin-when-cross-origin";
    holder.replaceChildren(frame);
  };

  const wire = (state: string, videoId: string | null) => {
    const btn = holder?.querySelector<HTMLElement>(`[data-state="${state}"]`);
    btn?.addEventListener("click", () => play(videoId, btn.dataset.channel), {
      once: true,
    });
  };

  async function check() {
    let data: { live?: { id: string; title?: string } | null; videos?: Array<{ id: string; title: string }> } | null =
      null;

    try {
      const res = await fetch("/api/youtube/feed.php", {
        headers: { Accept: "application/json" },
      });
      if (res.ok) data = await res.json();
    } catch {
      /* fall through to offline */
    }

    if (data?.live?.id) {
      const title = holder?.querySelector<HTMLElement>("[data-live-title]");
      if (title && data.live.title) title.textContent = data.live.title;
      wire("live", data.live.id);
      show("live");
      return;
    }

    const latest = data?.videos?.[0] ?? null;
    if (latest) {
      const note = holder?.querySelector<HTMLElement>("[data-offline-note]");
      if (note) note.textContent = `Most recent: ${latest.title}`;
    }
    wire("offline", latest?.id ?? null);
    show("offline");
  }

  void check();

  // While someone sits on the page waiting for a service to start, keep
  // checking — but only while the tab is actually in front of them.
  setInterval(() => {
    if (document.visibilityState === "visible" && !holder?.querySelector("iframe")) {
      void check();
    }
  }, 60_000);
</script>

<style>
  .live-dot {
    animation: live-blink 1.6s ease-in-out infinite;
  }
  @keyframes live-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }
</style>

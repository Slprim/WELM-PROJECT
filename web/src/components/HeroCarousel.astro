---
import { Image } from "astro:assets";
import SanityImage from "./SanityImage.astro";
import { site, services } from "../data/site";
import type { HeroSlide } from "../lib/content";
import metadidomiImage from "../assets/hero-metadidomi.jpg";
import visionImage from "../assets/vision.jpg";

/**
 * The homepage hero carousel — the legacy site's video banner, rebuilt.
 *
 * The logo reveal, then the same three slides as the Bootstrap original
 * (welcome video, Metadidomi, the vision) with the same captions, but without jQuery or Bootstrap, and
 * meeting WCAG 2.2.2: auto-advancing content has a visible pause control,
 * stops on hover and on keyboard focus, and never starts at all under
 * `prefers-reduced-motion`.
 *
 * The source video was 25.7MB of 720p at 11.8 Mbps with an audio track that
 * is never heard. It is re-encoded to 849KB, muted, in `public/video/`.
 */

interface Props {
  /** Slides from Sanity. Empty means keep the built-in ones below. */
  slides?: HeroSlide[];
}

const { slides = [] } = Astro.props;

/**
 * Every Sunday gathering, earliest first. This rail used to name the
 * "Revelation" service alone, so the 7am Twi service was missing from the
 * first thing a visitor sees.
 */
const sundays = services.filter(
  (s) => s.where === "In person" && /sunday/i.test(s.when),
);

type Slide = {
  kind: "video" | "image";
  videoUrl?: string;
  poster?: string;
  remoteImage?: HeroSlide["image"];
  localImage?: ImageMetadata;
  imgClass?: string;
  eyebrow?: string | null;
  title: string;
  accent?: string | null;
  /** Trailing plain words after the highlighted ones. Built-in slides only. */
  suffix?: string;
  body?: string | null;
  alt?: string;
  /** The video slide holds longer so the clip can breathe. */
  duration: number;
  /**
   * Shown as-is: no navy wash, no caption, full opacity. For a clip that IS
   * the message — the logo reveal ends on a white card carrying the name, so
   * dimming it and writing "Kingdom of Gods" over the top would ruin it and
   * say the same thing twice.
   */
  clean?: boolean;
  /** Videos loop unless told not to. A reveal should hold its last frame. */
  loop?: boolean;
};

/** The slides the site ships with, used until any are published in Sanity. */
const builtIn: Slide[] = [
  {
    kind: "video",
    videoUrl: "/video/logo-reveal.mp4",
    poster: "/video/logo-reveal-poster.jpg",
    // Title is the accessible name of the slide only; nothing is rendered.
    title: "Kingdom of Gods",
    clean: true,
    loop: false,
    // The clip is 6.4s. Hold the finished logo for a beat, then move on.
    duration: 6800,
  },
  {
    kind: "video",
    videoUrl: "/video/hero.mp4",
    poster: "/video/hero-poster.jpg",
    eyebrow: "Welcome to",
    title: "Kingdom",
    accent: "of Gods",
    body: `${site.legalName}. ${site.tagline}.`,
    duration: 12000,
  },
  {
    kind: "image",
    localImage: metadidomiImage,
    imgClass: "object-[60%_center]",
    alt: "Pastor Faith Joseph teaching at a Metadidomi service",
    eyebrow: "Our vision",
    title: "That men will",
    accent: "live like God",
    body: `A house in ${site.address.city} where the word is taught without apology and lived without pretence.`,
    duration: 7000,
  },
  {
    kind: "image",
    localImage: visionImage,
    alt: "The congregation worshipping together",
    eyebrow: "It's a vision",
    title: "Building you into",
    accent: "the fullness",
    suffix: "of Christ",
    body: "Everyone is welcome — come as you are.",
    duration: 7000,
  },
];

const rendered: Slide[] =
  slides.length > 0
    ? slides.map((s) => ({
        kind: s.mediaType === "video" && s.videoUrl ? "video" : "image",
        videoUrl: s.videoUrl ?? undefined,
        remoteImage: s.image,
        alt: s.image?.alt ?? undefined,
        eyebrow: s.eyebrow,
        title: s.title,
        accent: s.accent,
        body: s.body,
        duration: s.mediaType === "video" ? 12000 : 7000,
      }))
    : builtIn;
---

<section
  id="hero"
  class="relative isolate flex min-h-[92svh] items-end overflow-hidden bg-navy-950"
  aria-roledescription="carousel"
  aria-label="Welcome"
  data-clean={rendered[0]?.clean ? "true" : undefined}
>
  {/* Runs during parse, before the bundled scripts, so the fixed header is
      already solid on first paint when the opening slide is clean. */}
  {rendered[0]?.clean && (
    <script is:inline>
      document.documentElement.setAttribute("data-hero-clean", "");
    </script>
  )}
  <!-- ===================== SLIDES ===================== -->
  <div class="absolute inset-0 -z-10">
    {
      rendered.map((slide, i) => (
        <div
          class="hero-slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-out"
          data-slide={i}
          data-duration={slide.duration}
          data-clean={slide.clean ? "true" : undefined}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${rendered.length}: ${slide.title}`}
        >
          {slide.kind === "video" ? (
            <video
              class={`hero-video h-full w-full object-center ${
                slide.clean
                  ? // Contain, not cover: a phone screen is tall and cover
                    // would crop the sides of a 16:9 clip - the logo mark and
                    // half the name. The section is white while this shows,
                    // so the letterbox is invisible.
                    "object-contain"
                  : "object-cover opacity-55"
              }`}
              poster={slide.poster}
              muted
              loop={slide.loop !== false}
              playsinline
              preload={i === 0 ? "auto" : "metadata"}
              aria-hidden="true"
              tabindex="-1"
            >
              <source src={slide.videoUrl} type="video/mp4" />
            </video>
          ) : slide.remoteImage?.url ? (
            <SanityImage
              image={slide.remoteImage}
              alt=""
              class={`h-full w-full object-cover opacity-55 ${slide.imgClass ?? "object-center"}`}
              sizes="100vw"
              widths={[640, 1024, 1600, 2048]}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
            />
          ) : slide.localImage ? (
            <Image
              src={slide.localImage}
              alt=""
              class={`h-full w-full object-cover opacity-55 ${slide.imgClass ?? "object-center"}`}
              widths={[640, 1024, 1600, 2048]}
              sizes="100vw"
              loading={i === 0 ? "eager" : "lazy"}
            />
          ) : null}
        </div>
      ))
    }

    <!-- Overlays sit above every slide so the wash never re-fades. They lift
         while a clean slide is showing (see the [data-clean] rules below). -->
    <div
      class="hero-wash absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/80 to-navy-950/30 transition-opacity duration-1000"
    >
    </div>
    <div class="hero-wash absolute inset-0 bg-navy-900/40 mix-blend-multiply transition-opacity duration-1000"></div>
  </div>

  <!-- ===================== CAPTIONS ===================== -->
  <div class="shell w-full pb-32 pt-36 sm:pb-36">
    <div class="max-w-5xl">
      {/* All three captions share one grid cell, so the block is always as
          tall as the tallest caption and none of them can spill over the
          CTA row below — which absolute positioning did. */}
      <div class="grid">
        {
          rendered.map((slide, i) => (
            <div
              class="hero-caption col-start-1 row-start-1 transition-all duration-700 ease-out"
              data-caption={i}
              aria-hidden={i !== 0 ? "true" : undefined}
            >
              {/* A clean slide carries its own words in the picture. The
                  wrapper stays so the grid keeps its height. */}
              {!slide.clean && (
                <>
                  {slide.eyebrow && (
                    <p class="eyebrow text-gold-400">{slide.eyebrow}</p>
                  )}
                  <h1 class="mt-7 font-display text-display-2xl font-light leading-[0.92] text-white">
                    {slide.title}
                    {slide.accent && (
                      <> <span class="italic text-gold-400">{slide.accent}</span></>
                    )}
                    {slide.suffix && <> {slide.suffix}</>}
                  </h1>
                  {slide.body && (
                    <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/75">
                      {slide.body}
                    </p>
                  )}
                </>
              )}
            </div>
          ))
        }
      </div>

      <!-- CTAs stay put across slides so the buttons never jump -->
      <div class="hero-ctas mt-11 flex flex-wrap items-center gap-4 transition-opacity duration-700">
        <a href="/live" class="btn-gold">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-navy-950 opacity-60"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-navy-950"
            ></span>
          </span>
          Watch live
        </a>
        <a href="/about" class="btn-ghost">Plan your visit</a>
      </div>
    </div>
  </div>

  <!-- ===================== CONTROLS =====================
       Indicators and buttons share one cluster on the right. Kept off the
       left edge so they never crowd the CTA row at narrow widths. -->
  {/* The service rail only exists at lg, so below that the controls sit near
      the hero's bottom edge. At bottom-28 they landed inside the CTA row. */}
  <div
    class="absolute bottom-6 right-5 z-20 flex items-center gap-4 sm:right-8 lg:bottom-32"
  >
    <div class="mr-1 flex items-center gap-2" role="tablist" aria-label="Choose slide">
      {
        rendered.map((_, i) => (
          <button
            type="button"
            class="hero-dot h-1.5 rounded-full bg-white/30 transition-all duration-300 hover:bg-white/60"
            data-dot={i}
            role="tab"
            aria-label={`Go to slide ${i + 1}`}
            aria-selected={i === 0 ? "true" : "false"}
          />
        ))
      }
    </div>

    <button
      type="button"
      id="hero-prev"
      class="grid h-11 w-11 place-items-center rounded-full border border-white/20 text-white transition hover:border-gold-500 hover:text-gold-400"
      aria-label="Previous slide"
      aria-controls="hero"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="h-4 w-4"
        aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg
      >
    </button>

    <button
      type="button"
      id="hero-playpause"
      class="grid h-11 w-11 place-items-center rounded-full border border-white/20 text-white transition hover:border-gold-500 hover:text-gold-400"
      aria-label="Pause slideshow"
      aria-controls="hero"
    >
      <svg
        data-icon="pause"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="h-4 w-4"
        aria-hidden="true"
        ><path d="M8 5h3v14H8zM13 5h3v14h-3z"></path></svg
      >
      <svg
        data-icon="play"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="hidden h-4 w-4"
        aria-hidden="true"><path d="M7 4l12 8-12 8z"></path></svg
      >
    </button>

    <button
      type="button"
      id="hero-next"
      class="grid h-11 w-11 place-items-center rounded-full border border-white/20 text-white transition hover:border-gold-500 hover:text-gold-400"
      aria-label="Next slide"
      aria-controls="hero"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="h-4 w-4"
        aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg
      >
    </button>
  </div>

  <!-- ===================== SERVICE RAIL ===================== -->
  <div
    class="absolute inset-x-0 bottom-0 z-10 hidden border-t border-white/10 bg-navy-950/60 backdrop-blur-md lg:block"
  >
    <div class="shell grid grid-cols-3 divide-x divide-white/10">
      <div class="py-6 pr-8">
        <p class="text-[0.65rem] uppercase tracking-[0.2em] text-gold-400">
          This Sunday
        </p>
        {
          sundays.map((s) => (
            <p class="mt-2 text-sm text-white">
              {s.name} · {s.time}
            </p>
          ))
        }
      </div>
      <div class="px-8 py-6">
        <p class="text-[0.65rem] uppercase tracking-[0.2em] text-gold-400">
          Every weekday
        </p>
        <p class="mt-2 text-sm text-white">Declaration Hour · 5:00 am</p>
      </div>
      <div class="py-6 pl-8">
        <p class="text-[0.65rem] uppercase tracking-[0.2em] text-gold-400">
          Find us
        </p>
        <a
          href={site.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 block text-sm text-white transition hover:text-gold-400"
        >
          {site.address.street}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Before JS runs, the first slide and caption stand alone so the hero is
     never blank — the legacy carousel showed nothing until Bootstrap booted.
     These are plain attribute selectors, so they must be *switched off* once
     the script takes over; otherwise slide 0 stays lit under every later
     slide and the captions stack on top of each other. The `.js-carousel`
     class (added on init) hands control entirely to `.is-active`. */
  .hero-slide[data-slide="0"],
  .hero-caption[data-caption="0"] {
    opacity: 1;
    transform: none;
  }

  .hero-caption {
    opacity: 0;
    transform: translateY(14px);
    /* Stacked captions must not swallow clicks meant for the live one. */
    pointer-events: none;
  }

  .js-carousel .hero-slide,
  .js-carousel .hero-caption {
    opacity: 0;
  }

  .js-carousel .hero-caption {
    transform: translateY(14px);
  }

  .hero-slide.is-active,
  .js-carousel .hero-slide.is-active {
    opacity: 1;
  }

  .hero-caption.is-active,
  .js-carousel .hero-caption.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hero-dot {
    width: 1.5rem;
  }

  .hero-dot[aria-selected="true"] {
    width: 3rem;
    background-color: var(--color-gold-500);
  }

  /* ---- A clean slide (the logo reveal) ------------------------------------
     The script sets [data-clean] on the section while one is showing. The
     navy wash lifts so the clip is seen as made; the CTA row steps aside for
     its six seconds; and because the clip is white, the controls that are
     normally white-on-navy switch to navy so they do not vanish. */
  #hero[data-clean] .hero-wash {
    opacity: 0;
  }
  #hero[data-clean] .hero-ctas {
    opacity: 0;
    pointer-events: none;
  }
  #hero[data-clean] .hero-dot {
    background-color: rgba(0, 24, 112, 0.3);
  }
  #hero[data-clean] .hero-dot[aria-selected="true"] {
    background-color: var(--color-gold-600);
  }
  #hero[data-clean] #hero-prev,
  #hero[data-clean] #hero-next,
  #hero[data-clean] #hero-playpause {
    color: var(--color-navy-900);
    border-color: rgba(0, 24, 112, 0.25);
  }

  /* Before the first clean slide fades out, the section behind it is navy,
     so the crossfade goes white -> navy -> next slide's wash. Match the
     section to the clip so it goes straight to the next slide instead. */
  #hero[data-clean] {
    background-color: #fff;
    transition: background-color 1000ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-caption {
      transition: none;
    }
  }
</style>

<script>
  const hero = document.getElementById("hero");
  if (hero) {
    const slides = Array.from(
      hero.querySelectorAll<HTMLElement>(".hero-slide"),
    );
    const captions = Array.from(
      hero.querySelectorAll<HTMLElement>(".hero-caption"),
    );
    const dots = Array.from(hero.querySelectorAll<HTMLElement>(".hero-dot"));
    // More than one slide can be a video now (the logo reveal, then the
    // welcome clip), so each slide keeps its own, and only the one on screen
    // runs - decoding a clip behind another slide is wasted battery.
    const videos = slides.map((el) =>
      el.querySelector<HTMLVideoElement>(".hero-video"),
    );
    const prevBtn = document.getElementById("hero-prev");
    const nextBtn = document.getElementById("hero-next");
    const playBtn = document.getElementById("hero-playpause");

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Respect the browser's data-saver setting: no autoplaying video on a
    // metered connection. Relevant for the mobile-heavy Ghanaian audience.
    const saveData =
      (navigator as Navigator & { connection?: { saveData?: boolean } })
        .connection?.saveData === true;

    // Each slide carries its own dwell time, so the count is not fixed at three.
    const DURATIONS = slides.map((el) => Number(el.dataset.duration) || 7000);

    let index = 0;
    let timer: number | undefined;
    let paused = reduced.matches;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;

      slides.forEach((el, i) => {
        el.classList.toggle("is-active", i === index);
        el.setAttribute("aria-hidden", String(i !== index));
      });

      captions.forEach((el, i) => {
        el.classList.toggle("is-active", i === index);
        el.setAttribute("aria-hidden", String(i !== index));
      });

      dots.forEach((el, i) =>
        el.setAttribute("aria-selected", String(i === index)),
      );

      // A clean slide lifts the navy wash and hides the caption and CTAs so
      // the clip is seen as made. The attribute drives the CSS below. The
      // same flag goes on <html> for the fixed header, which sits outside
      // this section and would otherwise be white text on the white clip.
      const clean = slides[index].dataset.clean === "true";
      hero.toggleAttribute("data-clean", clean);
      document.documentElement.toggleAttribute("data-hero-clean", clean);
      window.dispatchEvent(new Event("hero:clean"));

      videos.forEach((v, i) => {
        if (!v) return;
        if (i === index && !saveData && !reduced.matches) {
          // Restart a non-looping clip so the reveal replays each time the
          // slide comes round, rather than sitting on its last frame.
          if (!v.loop) v.currentTime = 0;
          v.play().catch(() => {
            /* autoplay refused; the poster stands in */
          });
        } else {
          v.pause();
        }
      });
    };

    const stop = () => {
      if (timer) window.clearTimeout(timer);
      timer = undefined;
    };

    const schedule = () => {
      stop();
      if (paused) return;
      timer = window.setTimeout(() => {
        show(index + 1);
        schedule();
      }, DURATIONS[index]);
    };

    const setPaused = (value: boolean) => {
      paused = value;
      playBtn?.setAttribute(
        "aria-label",
        value ? "Play slideshow" : "Pause slideshow",
      );
      playBtn
        ?.querySelector('[data-icon="pause"]')
        ?.classList.toggle("hidden", value);
      playBtn
        ?.querySelector('[data-icon="play"]')
        ?.classList.toggle("hidden", !value);
      if (value) stop();
      else schedule();
    };

    const goto = (next: number) => {
      show(next);
      if (!paused) schedule();
    };

    prevBtn?.addEventListener("click", () => goto(index - 1));
    nextBtn?.addEventListener("click", () => goto(index + 1));
    playBtn?.addEventListener("click", () => setPaused(!paused));

    dots.forEach((dot, i) => dot.addEventListener("click", () => goto(i)));

    // Arrow-key control when focus is anywhere inside the hero.
    hero.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        goto(index - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        goto(index + 1);
      }
    });

    // WCAG 2.2.2 — pause on hover and on keyboard focus.
    hero.addEventListener("mouseenter", stop);
    hero.addEventListener("mouseleave", () => !paused && schedule());
    hero.addEventListener("focusin", stop);
    hero.addEventListener("focusout", () => !paused && schedule());

    // Don't burn cycles advancing a carousel nobody is looking at.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else if (!paused) schedule();
    });

    // Hand opacity control over to .is-active now that the script is live.
    hero.classList.add("js-carousel");

    show(0);
    if (reduced.matches) setPaused(true);
    else schedule();
  }
</script>

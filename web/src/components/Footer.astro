---
import Logo from "./Logo.astro";
import { nav, site, services } from "../data/site";

const year = new Date().getFullYear();
const sundays = services.filter((s) => s.when.includes("Sunday"));
---

<footer class="bg-navy-950 text-white/70">
  <div class="shell py-20">
    <div class="grid gap-14 lg:grid-cols-12">
      <!-- Identity -->
      <div class="lg:col-span-4">
        <Logo class="text-white" />
        <p class="mt-6 max-w-xs text-sm leading-relaxed">
          {site.tagline}. A house in {site.address.city} raising believers who carry
          the word of eternal life.
        </p>

        <div class="mt-8 flex gap-3">
          {
            [
              ["Facebook", site.social.facebook],
              ["Instagram", site.social.instagram],
              ["YouTube", site.social.youtube],
            ].map(([label, href]) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-white/15 px-4 py-2 text-xs font-medium tracking-wide transition hover:border-gold-500 hover:text-gold-400"
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Explore -->
      <div class="lg:col-span-2">
        <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-white">
          Explore
        </h3>
        <ul class="mt-6 space-y-3 text-sm">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class="transition hover:text-gold-400"
                >
                  {item.label}
                  {item.external && <span aria-hidden="true"> ↗</span>}
                  {item.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/give" class="transition hover:text-gold-400">Give</a>
          </li>
        </ul>
      </div>

      <!-- Gather -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-white">
          Gather with us
        </h3>
        <ul class="mt-6 space-y-4 text-sm">
          {
            sundays.map((s) => (
              <li>
                <span class="block text-white">{s.name}</span>
                <span class="text-white/60">
                  {s.when} · {s.time}
                </span>
              </li>
            ))
          }
          <li>
            <a
              href={site.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="block transition hover:text-gold-400"
            >
              {site.address.street}
              <span class="block text-white/60">
                {site.address.city}, {site.address.country}
              </span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-white">
          Stay in touch
        </h3>
        <p class="mt-6 text-sm leading-relaxed">
          Service reminders and new teachings, straight to your inbox.
        </p>

        <form class="mt-6 space-y-3" data-newsletter>
          <label for="footer-email" class="sr-only">Email address</label>
          <input
            id="footer-email"
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm text-white placeholder:text-white/40 focus:border-gold-500 focus:outline-none"
          />
          <button type="submit" class="btn-gold w-full !py-3">Subscribe</button>
        </form>
        <p class="mt-3 text-xs text-white/40">
          Not yet connected to a mailing provider.
        </p>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-8 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p class="text-white/40">
        {site.vision}
      </p>
    </div>
  </div>
</footer>
